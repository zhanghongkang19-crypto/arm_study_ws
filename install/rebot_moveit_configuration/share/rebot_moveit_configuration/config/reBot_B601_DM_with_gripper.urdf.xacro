<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reBot_B601_DM_with_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import reBot_B601_DM_with_gripper urdf file -->
    <xacro:include filename="$(find rebot_description)/urdf/reBot_B601_DM_with_gripper.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="reBot_B601_DM_with_gripper.ros2_control.xacro" />


    <xacro:reBot_B601_DM_with_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
