<mujoco model="reBot-DevArm_fixend">
  <compiler angle="radian"/>
  <option timestep="0.002"  gravity="0 0 -9.81"/>

  <asset>
    <!-- 定义棋盘格地面纹理 -->
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" 
             rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"/>
    <!-- 定义地面材质 -->
    <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true" 
              reflectance="0.2"/>
    
    <!-- 天空背景纹理（可选） -->
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" 
             rgb2="0.0 0.1 0.2" width="512" height="512"/>
  </asset>

  <!-- 2. 全局视觉渲染设置（阴影与质量） -->
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <map znear="0.01"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <mesh name="base_link" content_type="model/stl" file="meshes/base_link.stl"/>
    <mesh name="link1" content_type="model/stl" file="meshes/link1.stl"/>
    <mesh name="link2" content_type="model/stl" file="meshes/link2.stl"/>
    <mesh name="link3" content_type="model/stl" file="meshes/link3.stl"/>
    <mesh name="link4" content_type="model/stl" file="meshes/link4.stl"/>
    <mesh name="link5" content_type="model/stl" file="meshes/link5.stl"/>
    <mesh name="link6" content_type="model/stl" file="meshes/link6.stl"/>
    <mesh name="end_link" content_type="model/stl" file="meshes/end_link.stl"/>
  </asset>

  <worldbody>
    <!-- 定制平行光源（带有阴影效果） -->
    <light name="top_light" pos="0 0 3" dir="0 0 -1" directional="true" 
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="true"/>

    <!-- 定义无限大地面 (Plane) -->
    <!-- type="plane": 平面 geometry -->
    <!-- size="0 0 0.1": 前两个 0 表示在 X/Y 方向无限延伸，0.1 为网格厚度 -->
    <!-- material: 关联上面定义的棋盘格材质 -->
    <!-- condim="3": 设置摩擦力属性模型 -->
    <geom name="ground" type="plane" size="0 0 0.1" material="grid_mat" condim="3" friction="1.0 0.005 0.0001"/>
    <geom type="mesh" rgba="0.62745 0.62745 0.62745 1" mesh="base_link"/>
    <body name="link1" pos="-8.416e-05 0 0.08465">
      <inertial pos="0.000113615 -0.00061632 0.0236476" quat="0.672066 0.672066 0.219836 -0.219836" mass="0.1613" diaginertia="0.000272817 0.000213413 0.00015464"/>
      <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-2.8 2.8" actuatorfrcrange="-27 27" damping="1.0"/>
      <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link1"/>
      <body name="link2" pos="0.020084 0.031625 0.05555" quat="0.707105 -0.707108 0 0">
        <inertial pos="-0.132256 -0.0030617 -0.0308307" quat="0.00176765 0.707354 0.00179466 0.706855" mass="1.3266" diaginertia="0.0128139 0.0125599 0.000733734"/>
        <joint name="joint2" pos="0 0 0" axis="0 0 -1" range="-3.14 0" actuatorfrcrange="-27 27" damping="1.0"/>
        <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link2"/>
        <body name="link3" pos="-0.264 0 0">
          <inertial pos="0.12104 -0.0536211 -0.0310138" quat="-0.00138181 0.704593 0.00278372 0.709605" mass="0.8353" diaginertia="0.00648251 0.00632715 0.000467564"/>
          <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-3.14 0" actuatorfrcrange="-27 27" damping="1.0"/>
          <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link3"/>
          <body name="link4" pos="0.2426 -0.054 -0.001625">
            <inertial pos="0.0608201 -0.0511712 -0.0302995" quat="0.619751 0.601248 0.365808 0.347267" mass="0.52" diaginertia="0.000889485 0.000667165 0.000323211"/>
            <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-1.87 1.57" actuatorfrcrange="-7 7" damping="1.0"/>
            <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link4"/>
            <body name="link5" pos="0.078308 -0.0375 -0.03" quat="0.707105 -0.707108 0 0">
              <inertial pos="-0.00502802 1.73866e-06 0.0386233" quat="0.644154 0.196994 0.180566 0.716697" mass="0.383" diaginertia="0.000217429 0.000212237 0.000157335"/>
              <joint name="joint5" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-7 7" damping="1.0"/>
              <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link5"/>
              <body name="link6" pos="0.028008 0 0.04" quat="0.707105 0 0.707108 0">
                <inertial pos="5.50089e-06 -3.71802e-05 0.0578217" quat="0.999981 -0.00127532 -0.000304602 -0.00594064" mass="0.8663" diaginertia="0.00127909 0.000983777 0.000513199"/>
                <joint name="joint6" pos="0 0 0" axis="0 0 1" range="-3.14 3.14" actuatorfrcrange="-7 7" damping="1.0"/>
                <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link6"/>
                <geom pos="0 0 0.15539" quat="3.27579e-05 0.707108 -3.27581e-05 0.707105" type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="end_link"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>


  <actuator>
    <position joint="joint1" kp="100" kv="10"/>
    <position joint="joint2" kp="100" kv="10"/>
    <position joint="joint3" kp="100" kv="10"/>
    <position joint="joint4" kp="50"  kv="5"/>
    <position joint="joint5" kp="50"  kv="5"/>
    <position joint="joint6" kp="50"  kv="5"/>
  </actuator>
</mujoco>