<mujoco model="reBot_B601_DM_with_gripper">
  <compiler angle="radian" />
  <option timestep="0.001" gravity="0 0 -9.81" >
    <flag filterparent="enable"/>
  </option>
  

  <!-- 2. 全局视觉渲染设置（阴影与质量） -->
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <map znear="0.01"/>
    <quality shadowsize="2048"/>
  </visual>


  <asset>
    <!-- 定义棋盘格地面纹理 -->
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" 
              rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"/>
    <!-- 定义地面材质 -->
    <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true" 
                reflectance="0.2"/>
    <!-- 天空背景纹理（可选） -->
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" 
              rgb2="0.0 0.1 0.2" width="512" height="512"/>

    <mesh name="base_link" content_type="model/stl" file="./meshes_b601_gripper/base_link.STL"/>
    <mesh name="link1" content_type="model/stl" file="./meshes_b601_gripper/link1.STL"/>
    <mesh name="link2" content_type="model/stl" file="./meshes_b601_gripper/link2.STL"/>
    <mesh name="link3" content_type="model/stl" file="./meshes_b601_gripper/link3.STL"/>
    <mesh name="link4" content_type="model/stl" file="./meshes_b601_gripper/link4.STL"/>
    <mesh name="link5" content_type="model/stl" file="./meshes_b601_gripper/link5.STL"/>
    <mesh name="link6" content_type="model/stl" file="./meshes_b601_gripper/link6.STL"/>
    <mesh name="gripper_link" content_type="model/stl" file="./meshes_b601_gripper/gripper_link.STL"/>
    <mesh name="gripper_left" content_type="model/stl" file="./meshes_b601_gripper/gripper_left.STL"/>
    <mesh name="gripper_right" content_type="model/stl" file="./meshes_b601_gripper/gripper_right.STL"/>
  </asset>

  <worldbody>
    <!-- 定制平行光源（带有阴影效果） -->
    <light name="top_light" pos="0 0 3" dir="0 0 -1" directional="true" 
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="true"/>

    <!-- 定义无限大地面 (Plane) -->
    <!-- type="plane": 平面 geometry -->
    <!-- size="0 0 0.1": 前两个 0 表示在 X/Y 方向无限延伸，0.1 为网格厚度 -->
    <!-- material: 关联上面定义的棋盘格材质 -->
    <!-- condim="3": 设置摩擦力属性模型 -->
    <geom name="ground" type="plane" size="0 0 0.1" material="grid_mat" condim="3" friction="1.0 0.005 0.0001"/>
    <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="base_link"/>
    <body name="link1" pos="-8.416e-05 0 0.08465">
      <inertial pos="1.20585e-05 -0.000522463 0.0197722" quat="0.67154 0.671536 -0.221442 0.221444" mass="0.0840736" diaginertia="9.14519e-05 7.4328e-05 5.08886e-05"/>
      <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-2.8 2.8" actuatorfrcrange="-27 27" damping="1"/>
      <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link1"/>
      <body name="link2" pos="0.020084 0.031625 0.05555" quat="0.707105 -0.707108 0 0">
        <inertial pos="-0.132245 -0.00305032 -0.0309299" quat="0.465289 0.532916 0.464759 0.532453" mass="0.710394" diaginertia="0.00186328 0.00186002 0.000250025"/>
        <joint name="joint2" pos="0 0 0" axis="0 0 -1" range="-3.14 0" actuatorfrcrange="-27 27" damping="1" />
        <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link2"/>
        <body name="link3" pos="-0.264 0 0">
          <inertial pos="0.121508 -0.0537568 -0.0310862" quat="0.0138452 0.705615 0.0242746 0.708044" mass="0.524942" diaginertia="0.00125571 0.00124928 0.000159907"/>
          <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-3.14 0" actuatorfrcrange="-27 27" damping="1" />
          <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link3"/>
          <body name="link4" pos="0.2426 -0.054 -0.001625">
            <inertial pos="0.0612382 -0.051523 -0.030334" quat="0.429326 0.43808 0.555119 0.56179" mass="0.191139" diaginertia="0.000115773 0.000101138 6.89489e-05"/>
            <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-1.87 1.57" actuatorfrcrange="-17 17" damping="1" />
            <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link4"/>
            <body name="link5" pos="0.078308 -0.0375 -0.03" quat="0.707105 -0.707108 0 0">
              <inertial pos="-0.00504933 1.74603e-06 0.0387866" quat="0.705279 0.702041 0.0698205 -0.0696118" mass="0.150004" diaginertia="6.84851e-05 5.38003e-05 5.17187e-05"/>
              <joint name="joint5" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-7 7" damping="2.0" frictionloss="0.05" />
              <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link5"/>
              <body name="link6" pos="0.023692 0 0.04" quat="0.707105 0 0.707108 0">
                <inertial pos="-1.1909e-06 6.62566e-05 0.0418402" quat="0.498028 0.499168 -0.501931 0.500863" mass="0.200527" diaginertia="0.000240939 0.000238725 9.19685e-05"/>
                <joint name="joint6" pos="0 0 0" axis="0 0 1" range="-3.14 3.14" actuatorfrcrange="-7 7" damping="2.0" frictionloss="0.05" />
                <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="link6"/>
                <geom pos="0 0 0.15971" quat="0.707105 0 -0.707108 0" type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="gripper_link" contype="0"  conaffinity="0"/>
                <body name="gripper_left" pos="1.31856e-05 2.7531e-05 0.117619" quat="0.499998 0.500002 -0.5 -0.5">
                  <inertial pos="0.00937155 -0.0183514 -0.00213051" quat="-0.219218 0.644983 0.318442 0.659193" mass="0.0423279" diaginertia="1.13774e-05 1.08393e-05 8.55489e-06"/>
                  <joint name="gripper_joint1" pos="0 0 0" axis="1 0 0" type="slide" range="0 0.0715" actuatorfrcrange="-7 7" damping="0.5" frictionloss="0.05" solreflimit="0.02 1"/>
                  <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="gripper_left"/>
                </body>
                <body name="gripper_right" pos="-1.28764e-05 -2.7531e-05 0.117619" quat="0.499998 -0.500002 -0.5 0.5">
                  <inertial pos="0.00937155 0.0183514 0.00213051" quat="0.318442 0.659193 -0.219218 0.644983" mass="0.0423279" diaginertia="1.13774e-05 1.08393e-05 8.55489e-06"/>
                  <joint name="gripper_joint2" pos="0 0 0" axis="1 0 0" type="slide" range="0 0.0715" actuatorfrcrange="-7 7" damping="0.5" frictionloss="0.05" solreflimit="0.02 1"/>
                  <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="gripper_right"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="gripper_left"/>
    <exclude body1="link6" body2="gripper_right"/>
    <exclude body1="gripper_left" body2="gripper_right"/>
  </contact>

  <!-- <actuator>
    <position joint="joint1" kp="100" kv="20"/>
    <position joint="joint2" kp="100" kv="20"/>
    <position joint="joint3" kp="100" kv="20"/>
    <position joint="joint4" kp="25"  kv="8"/>
    <position joint="joint5" kp="25"  kv="8"/>
    <position joint="joint6" kp="25"  kv="8"/>

    <position joint="gripper_joint1" kp="10"  kv="1"/>
    <position joint="gripper_joint2" kp="10"  kv="1"/>
  </actuator> -->

  <actuator>
    <!-- 机械臂主关节（前3轴：基座/大臂/小臂，力矩范围可根据电机规格自定义） -->
    <motor joint="joint1" />
    <motor joint="joint2" />
    <motor joint="joint3" />
    
    <!-- 机械臂末端关节（后3轴：手腕） -->
    <motor joint="joint4" />
    <motor joint="joint5" />
    <motor joint="joint6" />

    <!-- 夹爪关节 -->
    <motor joint="gripper_joint1" />
    <motor joint="gripper_joint2" />
  </actuator>
</mujoco>
